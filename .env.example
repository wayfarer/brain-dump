# Optional when signed in with `codex login` (subscription chat).
# Required for embeddings/vector search, and used as the chat fallback.
OPENAI_API_KEY=

# Optional: force a chat backend — auto (default) | codex | openai
# BRAINDUMP_BACKEND=auto

# Set to 1 to run integration tests against live backends (requires OPENAI_API_KEY)
# BRAINDUMP_LIVE_TESTS=1
